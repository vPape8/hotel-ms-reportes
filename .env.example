# Copia este archivo como .env y reemplaza los valores de ejemplo.
PORT=8086

# Kafka: bootstrap-servers (en docker-compose: kafka-1:29092,kafka-2:29092,kafka-3:29092).
# Si se deja vacío, el servicio arranca sin consumir (útil para probar la API).
KAFKA_BROKERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_GRUPO=reportes
# Miembros del grupo en este proceso: 3 = uno por partición (guía 3.3.1). Con 4, uno queda sin partición.
KAFKA_CONCURRENCIA=3
# FixedBackOff(1000, 2): 3 intentos, 1 s entre cada uno.
KAFKA_REINTENTOS_INTENTOS=3
KAFKA_REINTENTOS_ESPERA_MS=1000
# Demo: las reservas de esta habitación simulan una falla temporal y terminan en reservas.DLT.
SIMULAR_FALLO_HABITACION=HAB-FALLA

# MySQL: proyección de reportes (tablas reportes_reservas y processed_messages). Vacío = memoria.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hotel

# Microsoft Entra ID: los KPIs son solo para el rol ADMIN.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
ENTRA_EXIGIR_ROL=true
ENTRA_ROL_REQUERIDO=ADMIN
